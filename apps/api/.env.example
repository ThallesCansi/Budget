# Postgres connection. Supabase: Project Settings → Database → Connection string (Session pooler).
# Local without Docker: run `pnpm --filter @budget/api db:local` and paste the printed URL.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres

# Supabase project URL (tokens are verified against <SUPABASE_URL>/auth/v1/.well-known/jwks.json)
SUPABASE_URL=http://127.0.0.1:54321
# Only for legacy HS256 projects / `supabase start` (Settings → API → JWT secret)
SUPABASE_JWT_SECRET=

# Comma-separated list of allowed web origins
CORS_ORIGINS=http://localhost:3000

# Shared secret used by the Vercel cron to call /internal/jobs/daily
CRON_SECRET=

SENTRY_DSN=
ENVIRONMENT=development
